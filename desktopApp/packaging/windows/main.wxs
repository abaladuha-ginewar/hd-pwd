<?xml version="1.0" encoding="utf-8"?>
<!--
  Based on JDK 17 jpackage main.wxs.
  Product Id is regenerated every build, and same-version upgrades are allowed.
  Existing installs are detected, prompted, uninstalled, and default back to the old path.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifdef JpIsSystemWide ?>
    <?define JpInstallScope="perMachine"?>
  <?else?>
    <?define JpInstallScope="perUser"?>
  <?endif?>

  <?define JpProductLanguage=2052 ?>
  <?define JpInstallerVersion=200 ?>
  <?define JpCompressedMsi=yes ?>

  <?ifdef JpAllowUpgrades ?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectUpgrade="yes"?>
  <?endif?>
  <?ifdef JpAllowDowngrades ?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="no"?>
  <?else?>
    <?define JpUpgradeVersionOnlyDetectDowngrade="yes"?>
  <?endif?>

  <?include $(var.JpConfigDir)/overrides.wxi ?>

  <Product
    Id="*"
    Name="$(var.JpAppName)"
    Language="$(var.JpProductLanguage)"
    Codepage="936"
    Version="$(var.JpAppVersion)"
    Manufacturer="$(var.JpAppVendor)"
    UpgradeCode="$(var.JpProductUpgradeCode)">

    <Package
      Description="$(var.JpAppDescription)"
      Manufacturer="$(var.JpAppVendor)"
      InstallerVersion="$(var.JpInstallerVersion)"
      Compressed="$(var.JpCompressedMsi)"
      InstallScope="$(var.JpInstallScope)" Platform="x64"
    />

    <Media Id="1" Cabinet="Data.cab" EmbedCab="yes" />

    <Upgrade Id="$(var.JpProductUpgradeCode)">
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectUpgrade)"
        Property="JP_UPGRADABLE_FOUND"
        Maximum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMaximum="yes" />
      <UpgradeVersion
        OnlyDetect="$(var.JpUpgradeVersionOnlyDetectDowngrade)"
        Property="JP_DOWNGRADABLE_FOUND"
        Minimum="$(var.JpAppVersion)"
        MigrateFeatures="yes"
        IncludeMinimum="$(var.JpUpgradeVersionOnlyDetectDowngrade)" />
    </Upgrade>

    <?ifndef JpAllowUpgrades ?>
    <CustomAction Id="JpDisallowUpgrade" Error="!(loc.DisallowUpgradeErrorMessage)" />
    <?endif?>
    <?ifndef JpAllowDowngrades ?>
    <CustomAction Id="JpDisallowDowngrade" Error="!(loc.DowngradeErrorMessage)" />
    <?endif?>

    <Directory Id="TARGETDIR" Name="SourceDir"/>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="HdPwdInstallDirRegistry" Guid="a7c3e91b-4d2f-4a18-9b6e-2c8f1d0a5e74">
        <RegistryValue Root="HKMU" Key="Software\hd-pwd" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Property Id="PREVIOUSINSTALLDIR">
      <RegistrySearch Id="HdPwdInstallDirHKCU" Root="HKCU" Key="Software\hd-pwd" Name="InstallDir" Type="directory" />
    </Property>
    <Property Id="PREVIOUSINSTALLDIR_LM">
      <RegistrySearch Id="HdPwdInstallDirHKLM" Root="HKLM" Key="Software\hd-pwd" Name="InstallDir" Type="directory" Win64="yes" />
    </Property>

    <CustomAction Id="GetPreviousInstallDir" Script="vbscript" Execute="immediate">
<![CDATA[
On Error Resume Next
Dim codes, parts, code, installer, loc, i
codes = Session.Property("JP_UPGRADABLE_FOUND")
If codes = "" Then codes = Session.Property("JP_DOWNGRADABLE_FOUND")
If codes <> "" Then
  Set installer = CreateObject("WindowsInstaller.Installer")
  parts = Split(codes, ";")
  For i = 0 To UBound(parts)
    code = Trim(parts(i))
    If code <> "" Then
      loc = installer.ProductInfo(code, "InstallLocation")
      If loc <> "" Then Exit For
    End If
  Next
End If
If loc = "" Then loc = Session.Property("PREVIOUSINSTALLDIR")
If loc = "" Then loc = Session.Property("PREVIOUSINSTALLDIR_LM")
If loc <> "" Then
  If Right(loc, 1) <> "\" Then loc = loc & "\"
  Session.Property("PREVIOUSINSTALLDIR") = loc
End If
]]>
    </CustomAction>
    <CustomAction Id="SetInstallDirFromPrevious" Directory="INSTALLDIR" Value="[PREVIOUSINSTALLDIR]" />

    <Feature Id="DefaultFeature" Title="!(loc.MainFeatureTitle)" Level="1">
      <ComponentGroupRef Id="Shortcuts"/>
      <ComponentGroupRef Id="Files"/>
      <ComponentGroupRef Id="FileAssociations"/>
      <ComponentRef Id="HdPwdInstallDirRegistry"/>
    </Feature>

    <CustomAction Id="JpSetARPINSTALLLOCATION" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]" />
    <CustomAction Id="JpSetARPCOMMENTS" Property="ARPCOMMENTS" Value="$(var.JpAppDescription)" />
    <CustomAction Id="JpSetARPCONTACT" Property="ARPCONTACT" Value="$(var.JpAppVendor)" />
    <CustomAction Id="JpSetARPSIZE" Property="ARPSIZE" Value="$(var.JpAppSizeKb)" />

    <?ifdef JpHelpURL ?>
      <CustomAction Id="JpSetARPHELPLINK" Property="ARPHELPLINK" Value="$(var.JpHelpURL)" />
    <?endif?>

    <?ifdef JpAboutURL ?>
      <CustomAction Id="JpSetARPURLINFOABOUT" Property="ARPURLINFOABOUT" Value="$(var.JpAboutURL)" />
    <?endif?>

    <?ifdef JpUpdateURL ?>
      <CustomAction Id="JpSetARPURLUPDATEINFO" Property="ARPURLUPDATEINFO" Value="$(var.JpUpdateURL)" />
    <?endif?>

    <?ifdef JpIcon ?>
    <Property Id="ARPPRODUCTICON" Value="JpARPPRODUCTICON"/>
    <Icon Id="JpARPPRODUCTICON" SourceFile="$(var.JpIcon)"/>
    <?endif?>

    <UIRef Id="JpUI"/>
    <UI>
      <Dialog Id="ExistingInstallDlg" Width="370" Height="160" Title="[ProductName] 安装">
        <Control Id="OK" Type="PushButton" X="220" Y="125" Width="70" Height="17" Default="yes" Text="确定">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="295" Y="125" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
        <Control Id="Text" Type="Text" X="20" Y="18" Width="330" Height="95" NoPrefix="yes">
          <Text>系统已安装 [ProductName]。继续将卸载旧版本，并默认安装到原来的目录。您也可以在下一步修改安装路径。</Text>
        </Control>
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="SpawnDialog" Value="ExistingInstallDlg" Order="1">JP_UPGRADABLE_FOUND OR JP_DOWNGRADABLE_FOUND</Publish>
    </UI>

    <InstallUISequence>
      <Custom Action="GetPreviousInstallDir" After="FindRelatedProducts">JP_UPGRADABLE_FOUND OR JP_DOWNGRADABLE_FOUND</Custom>
      <Custom Action="SetInstallDirFromPrevious" After="CostFinalize">PREVIOUSINSTALLDIR</Custom>
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="GetPreviousInstallDir" After="FindRelatedProducts">(JP_UPGRADABLE_FOUND OR JP_DOWNGRADABLE_FOUND) AND UILevel &lt; 5</Custom>
      <Custom Action="SetInstallDirFromPrevious" After="CostFinalize">PREVIOUSINSTALLDIR AND UILevel &lt; 5</Custom>
      <Custom Action="JpSetARPINSTALLLOCATION" After="SetInstallDirFromPrevious">Not Installed</Custom>
      <Custom Action="JpSetARPCOMMENTS" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPCONTACT" After="CostFinalize">Not Installed</Custom>
      <Custom Action="JpSetARPSIZE" After="CostFinalize">Not Installed</Custom>
      <?ifdef JpHelpURL ?>
        <Custom Action="JpSetARPHELPLINK" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpAboutURL ?>
        <Custom Action="JpSetARPURLINFOABOUT" After="CostFinalize">Not Installed</Custom>
      <?endif?>
      <?ifdef JpUpdateURL ?>
        <Custom Action="JpSetARPURLUPDATEINFO" After="CostFinalize">Not Installed</Custom>
      <?endif?>

      <?ifndef JpAllowUpgrades ?>
      <Custom Action="JpDisallowUpgrade" After="FindRelatedProducts">JP_UPGRADABLE_FOUND</Custom>
      <?endif?>
      <?ifndef JpAllowDowngrades ?>
      <Custom Action="JpDisallowDowngrade" After="FindRelatedProducts">JP_DOWNGRADABLE_FOUND</Custom>
      <?endif?>
      <RemoveExistingProducts After="InstallInitialize"/>
    </InstallExecuteSequence>

  </Product>
</Wix>
